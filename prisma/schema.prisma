generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TbUser {
  id            Int      @id @default(autoincrement())
  akun          String   @unique
  email         String   @unique
  noHp          String   @unique
  nama          String?
  passwordHash  String
  role          String   @default("user")
  akses         Json?
  bagian        String?
  downline      Json?
  upline        Json?
  aktif         Boolean  @default(true)
  dibuatOleh    String?
  dibuatTanggal DateTime @default(now())
  diubahOleh    String?
  diubahTanggal DateTime @updatedAt
}

model TbArtikel {
  id            String   @id @default(cuid())
  judul         String
  artikel       String
  terbit        Boolean  @default(false)
  dibuatOleh    String?  @map("dibuat_oleh")
  dibuatTanggal DateTime @default(now()) @map("dibuat_tanggal")
  diubahOleh    String?  @map("diubah_oleh")
  diubahTanggal DateTime @updatedAt @map("diubah_tanggal")
}

model TbMasterItem {
  id                  String   @id @default(cuid())
  kodeItem            String   @unique
  namaItem            String
  deskripsi           String?
  kategori            String? //BLOCK, SLAB, BOND , SHIELD
  jenisItem           String?
  hpp                 Int?
  harga               Int?
  satuan              String // m3
  nilaiSatuan         Float? // contoh: 0.75
  nilaiKonversi       Float? // 84 pcs
  satuanKonversi      String? // pcs
  nilaiPenggunaan     Float? // 10 = 0.75 (m3)
  satuanPenggunaan    String? //m2
  deskripsiPenggunaan String? //Luas Dinding (m²)
  gambarUrl           String?
  linkWeb             String?
  dibuatOleh          String?
  dibuatTanggal       DateTime @default(now())
  diubahOleh          String?
  diubahTanggal       DateTime @updatedAt
}

model TbMasterKomisi {
  id               String   @id @default(cuid())
  kategori         String   @unique
  persentase       Float?
  minTarget        Float?
  maxTarget        Float?
  persentaseBonus1 Float?
  persentaseBonus2 Float?
  dibuatOleh       String?
  dibuatTanggal    DateTime @default(now())
  diubahOleh       String?
  diubahTanggal    DateTime @updatedAt
}

model TbSimulasiKomisi {
  id                  String   @id @default(cuid())
  judul               String   @default("Simulasi Komisi")
  catatan             String?
  targetGlobal        Float? // Target global nominal (Rp)
  targetKategori      Json // { "Bond": "40%", "Shield": "30%" }
  achievementKategori Json // { "Bond": 1.2, "Shield": 0.9 }
  komisiDasarTotal    Float
  komisiDasarKategori Json // { "Bond": 2_000_000, "Shield": 1_000_000 }
  bonusUtamaTotal     Float
  bonusUtamaKategori  Json // { "Bond": 200_000, "Shield": 100_000 }
  bonusExtraTotal     Float
  bonusExtraKategori  Json // { "Bond": 40_000, "Shield": 0 }
  subtotalTotal       Float // Total keseluruhan = dasar + bonus utama + bonus ekstra
  rowsItem            Json // [{ id, kodeItem, kategori, harga, qty, persen, subtotal, ... }]
  dibuatOleh          String?
  dibuatTanggal       DateTime @default(now())
  diubahOleh          String?
  diubahTanggal       DateTime @updatedAt
}
