generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TbUser {
  id            Int      @id @default(autoincrement())
  akun          String   @unique
  email         String   @unique
  noHp          String   @unique
  nama          String?
  passwordHash  String
  role          String   @default("user")
  akses         Json?
  bagian        String?
  downline      Json?
  upline        Json?
  aktif         Boolean  @default(true)
  dibuatOleh    String?
  dibuatTanggal DateTime @default(now())
  diubahOleh    String?
  diubahTanggal DateTime @updatedAt
}

model TbMasterItem {
  id            String   @id @default(cuid())
  kodeItem      String   @unique
  namaItem      String
  deskripsi     String?
  harga         Int
  satuan        String
  kategori      String?
  merek         String?
  dibuatOleh    String?
  dibuatTanggal DateTime @default(now())
  diubahOleh    String?
  diubahTanggal DateTime @updatedAt
}
